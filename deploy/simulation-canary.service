[Unit]
Description=Weather Simulation C++ backend
Documentation=https://simulation.micutu.com
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=notify
WatchdogSec=30
User=micu
Group=micu
WorkingDirectory=/srv/canary/simulation.micutu.com/project/backend/build
EnvironmentFile=/etc/simulation/simulation.env
Environment=SIM_ALLOWED_ORIGIN=https://simulation.micutu.com
Environment=SIM_STATE_FILE=/srv/canary/simulation.micutu.com/project/state/grid.snapshot
Environment=SIM_HISTORY_FILE=/srv/canary/simulation.micutu.com/project/state/history.snapshot
ExecStart=/srv/canary/simulation.micutu.com/project/backend/build/weather_backend
Restart=always
RestartSec=5
StandardOutput=append:/srv/canary/simulation.micutu.com/project/logs/backend.log
StandardError=append:/srv/canary/simulation.micutu.com/project/logs/backend-error.log
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/srv/canary/simulation.micutu.com/project/logs
ReadWritePaths=/srv/canary/simulation.micutu.com/project/state
MemoryMax=512M
CPUQuota=80%
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
